# Vercel container image for the Spring Boot API (see /vercel.json).
# Build the .jar, then run it on a small Java runtime.

FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/target/pokedex-api-0.1.0.jar app.jar
# Vercel routes traffic to $PORT (default 80); application.yml reads it.
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["java", "-jar", "app.jar"]
