{
  "task": "05_1",
  "tests": [
    { "name": "0 to 10 step 1: the sheet's example, f(0)=-1.0 and f(10)=129.0",
      "input": ["0", "10", "1"],
      "expect": ["f(0) = -1.0", "f(1) = 3.0", "f(5) = 39.0", "f(10) = 129.0"] },
    { "name": "0 to 4 step 2: only even x, includes the stop",
      "input": ["0", "4", "2"],
      "expect": ["f(0) = -1.0", "f(2) = 9.0", "f(4) = 27.0"],
      "reject": ["f(1)", "f(3)"] },
    { "name": "1 to 3 step 1: a short table in the middle",
      "input": ["1", "3", "1"],
      "expect": ["f(1) = 3.0", "f(2) = 9.0", "f(3) = 17.0"] },
    { "name": "−2 to 2 step 1: negative start still works",
      "input": ["-2", "2", "1"],
      "expect": ["f(-2) = -3.0", "f(0) = -1.0", "f(2) = 9.0"] },
    { "name": "5 to 5 step 1: start equals stop → one line only",
      "input": ["5", "5", "1"],
      "expect": ["f(5) = 39.0"],
      "reject": ["f(4)", "f(6)"] },
    { "name": "0 to 1 step 0.5: half steps with a double",
      "input": ["0", "1", "0.5"],
      "expect": ["f(0) = -1.0", "f(0.5) = 0.75", "f(1) = 3.0"] }
  ]
}
