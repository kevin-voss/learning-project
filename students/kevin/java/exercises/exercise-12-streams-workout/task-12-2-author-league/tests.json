{
  "task": "12_2",
  "tests": [
    { "name": "two authors, better average prints first", "input": ["2", "Dune Herbert 4.5", "Emma Austen 4.1"],
      "expect": ["Herbert: 4.5 (1 books)", "Austen: 4.1 (1 books)", "best: Dune"] },
    { "name": "equal averages: name order decides", "input": ["4", "Emma Austen 4.4", "Road Orwell 3.9", "Persuasion Austen 4.0", "Animal Orwell 4.5"],
      "expect": ["Austen: 4.2 (2 books)", "Orwell: 4.2 (2 books)", "best: Animal"] },
    { "name": "average rounds to one decimal", "input": ["3", "Dalloway Woolf 4.0", "Orlando Woolf 4.5", "Lighthouse Woolf 4.0"],
      "expect": ["Woolf: 4.2 (3 books)", "best: Orlando"] },
    { "name": "top rating twice: alphabetically first title wins", "input": ["2", "Sea Gann 4.5", "Dune Herbert 4.5"],
      "expect": ["Gann: 4.5 (1 books)", "Herbert: 4.5 (1 books)", "best: Dune"],
      "reject": ["best: Sea"] },
    { "name": "one author only, count of two", "input": ["2", "Fable Aesop 3.5", "Odes Aesop 4.5"],
      "expect": ["Aesop: 4.0 (2 books)", "best: Odes"] },
    { "name": "three authors, counts differ, best from the top row", "input": ["5", "Iliad Homer 5.0", "Odyssey Homer 4.0", "Emma Austen 4.1", "Persuasion Austen 4.3", "Wigan Orwell 3.9"],
      "expect": ["Homer: 4.5 (2 books)", "Austen: 4.2 (2 books)", "Orwell: 3.9 (1 books)", "best: Iliad"] },
    { "name": "empty shelf: no league, best is (none)", "input": ["0"],
      "expect": ["best: (none)"], "reject": ["books"] }
  ]
}
