// 02 — types, sizes, and where values live.
//
// Every value in Tic has ONE type, a size in bytes, and a slot in memory.
// This tour prints as it goes. The very last line fails ON PURPOSE:
// that failure is today's lesson.

// ---- size_of: how many bytes a type takes ----
print(size_of(i32), size_of(f64));    // 4 8
print(size_of(i8), size_of(i64), size_of(bool), size_of(char));  // 1 8 1 4
// char takes 4 bytes: it holds a whole Unicode code point.

// ---- chars are small numbers underneath ----
char letter = 'A';
print(letter, i32(letter));           // A 65 — cast a char to i32 to see its code

// ---- casts change how a value is read ----
print(i32(2.7));                      // 2   — i32() TRUNCATES, it does not round
print(f64(7) / f64(2));               // 3.5 — float division keeps the fraction
print(7 / 2);                         // 3   — int / int throws the fraction away
print("n = " + 42);                   // n = 42 — str + number builds a str

// ---- a pointer is the address of a slot ----
i32 x = 42;
i32* p = &x;                          // & means "the address of x"
print(*p);                            // 42 — *p follows the pointer and reads x
*p = 99;                              // write THROUGH the pointer
print(x);                             // 99 — x changed, and we never typed "x ="

// ---- overflow: an i8 cannot count past 127 ----
// C would quietly wrap around to -128. Tic refuses, with a friendly error.
// Everything above this line ran fine. This last line stops the program
// with exit code 2 — on purpose, so you can see what Tic does instead.
i8 big = 127;
print(big + 1);                       // runtime error: i8 overflow (127 + 1)
