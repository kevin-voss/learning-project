// 04 — functions and recursion.
//
// Every function must SAY what it takes and what it returns.
// Tic checks every call before the program runs — a wrong call never runs.

// ---- a plain function: typed parameters, required return type ----
function greet(str name) -> str {
    return "hi " + name;
}

// ---- early return: leave the moment you know the answer ----
function sign(i32 n) -> i32 {
    if (n > 0) {
        return 1;
    }
    if (n < 0) {
        return -1;
    }
    return 0;                         // only left when n == 0
}

// ---- recursion: a function that calls itself ----
// The first branch (n <= 1) is the BASE CASE: it stops the chain.
function factorial(i32 n) -> i32 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);      // the leap of faith: trust your own function
}

// fibonacci: two recursive calls per step — a tree of calls, not a chain
function fib(i32 n) -> i32 {
    final i32 BASE = 2;               // a constant that lives inside this call
    if (n < BASE) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

// ---- top-level code: runs top to bottom ----
print(greet("Ada"));                  // hi Ada
print("sign:", sign(-5), sign(0), sign(9));

final i32 N = 10;                     // top-level constant: reassigning it is a compile error
print(N, "factorial is", factorial(N));

print("first fibonacci numbers:");
for (i32 i = 0; i < 8; i += 1) {
    print(fib(i));
}
