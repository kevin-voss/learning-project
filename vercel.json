{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node hub/scripts/build-site.mjs && node hub/scripts/check-links.mjs",
  "outputDirectory": "dist/site",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/hub/", "permanent": false }
  ]
